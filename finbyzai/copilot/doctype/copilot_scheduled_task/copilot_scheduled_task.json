{
 "doctype": "DocType",
 "name": "Copilot Scheduled Task",
 "module": "Copilot",
 "autoname": "hash",
 "engine": "InnoDB",
 "title_field": "title",
 "sort_field": "creation",
 "sort_order": "DESC",
 "field_order": [
  "title",
  "prompt",
  "enabled",
  "scheduled_for",
  "timezone",
  "recurrence",
  "cron_expression",
  "agent",
  "model",
  "knowledge_base",
  "next_run",
  "completed",
  "last_run",
  "last_conversation",
  "error"
 ],
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "prompt",
   "fieldtype": "Long Text",
   "label": "Task instructions",
   "reqd": 1
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "scheduled_for",
   "fieldtype": "Data",
   "label": "Start date and time",
   "reqd": 1,
   "description": "Local time in the selected timezone, e.g. 2026-10-09T09:00."
  },
  {
   "fieldname": "timezone",
   "fieldtype": "Data",
   "label": "Timezone",
   "reqd": 1
  },
  {
   "fieldname": "recurrence",
   "fieldtype": "Select",
   "label": "Repeat",
   "options": "Once\nHourly\nDaily\nWeekly\nMonthly\nCustom",
   "default": "Once",
   "reqd": 1
  },
  {
   "fieldname": "cron_expression",
   "fieldtype": "Data",
   "label": "Cron expression",
   "depends_on": "eval:doc.recurrence == 'Custom'",
   "mandatory_depends_on": "eval:doc.recurrence == 'Custom'"
  },
  {
   "fieldname": "agent",
   "label": "Agent",
   "fieldtype": "Link",
   "options": "AI Agent"
  },
  {
   "fieldname": "model",
   "label": "Model",
   "fieldtype": "Link",
   "options": "LLM"
  },
  {
   "fieldname": "knowledge_base",
   "label": "Knowledge Base",
   "fieldtype": "Link",
   "options": "Knowledge Base"
  },
  {
   "fieldname": "next_run",
   "label": "Next run (UTC)",
   "fieldtype": "Datetime",
   "read_only": 1,
   "in_list_view": 1,
   "search_index": 1,
   "description": "Stored in UTC. Copilot displays this in the task timezone."
  },
  {
   "fieldname": "completed",
   "label": "Completed",
   "fieldtype": "Check",
   "read_only": 1
  },
  {
   "fieldname": "last_run",
   "label": "Latest run",
   "fieldtype": "Link",
   "options": "Copilot Run",
   "read_only": 1
  },
  {
   "fieldname": "last_conversation",
   "label": "Latest result",
   "fieldtype": "Link",
   "options": "Copilot Conversation",
   "read_only": 1
  },
  {
   "fieldname": "error",
   "label": "Scheduling error",
   "fieldtype": "Long Text",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "if_owner": 1
  },
  {
   "role": "Copilot Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "if_owner": 1
  },
  {
   "role": "Copilot User",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "if_owner": 1
  }
 ]
}
